
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blockshield",
	"main": "src/index.js",
	"compatibility_date": "2026-08-08",
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"TURNSTILE_EXPECTED_ACTION": "analyze"
	},
	"secrets": {
		"required": [
			"API_KEY",
			"API_SECRET",
			"TURNSTILE_SECRET",
			"TURNSTILE_SITE_KEY",
			"TURNSTILE_EXPECTED_HOSTNAME"
		]
	},
	"assets": {
		"directory": "./public"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"class_name": "RateLimiter"
			}
		]
	},
	"queues": {
		"producers": [
			{
				"binding": "SECURITY_EVENTS",
				"queue": "edgeshield-security-events"
			}
		],
		"consumers": [
			{
				"queue": "edgeshield-security-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edgeshield-db",
			"database_id": "6f8382c9-cf1b-4ef4-83ac-6a90b8e18507",
			"migrations_dir": "migrations"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RateLimiter"
			]
		}
	]
}
